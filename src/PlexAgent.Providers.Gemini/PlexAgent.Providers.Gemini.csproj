<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PlexAgent.Providers.Gemini</RootNamespace>
    <PackageId>PlexAgent.Providers.Gemini</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Google Gemini generateContent adapter for Plex Agent with resilient HttpClient transport.</Description>
    <PackageTags>ai;llm;gemini;google;plexagent;tools;structured-output</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexAgent\PlexAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlexAgent.Providers.Gemini.Tests" />
  </ItemGroup>

</Project>
